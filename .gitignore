# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
ENV/
env/
.env

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.dmypy.json

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# ============================================================
# ML / Training outputs  (all output roots — catch-all pattern)
# ============================================================

# Catch-all: any *_outputs or outputs directory anywhere in tree
outputs/
archive_outputs/
enhanced_outputs/

# Also ignore any ad-hoc output folder that follows the same naming convention
*_outputs/

# ============================================================
# Model artefacts
# ============================================================
*.pt
*.pth
*.onnx
*.pb
*.h5
*.hdf5
*.joblib
*.pkl
*.pickle

# ============================================================
# Data files
# ============================================================
data/raw/
data/processed/

# Common data formats — do NOT commit raw/derived data
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.npz
*.npy
*.json
# Exception: keep package / config JSONs at repo root
!package.json
!package-lock.json

# ============================================================
# Logs & run artefacts
# ============================================================
*.log
*.txt
# Exceptions — keep documentation / dependency files
!requirements.txt
!README.txt

# TensorBoard / experiment tracking
runs/
tb_logs/
mlruns/
wandb/

# ============================================================
# OS & Editor noise
# ============================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# ============================================================
# Secrets & credentials
# ============================================================
.env
*.env.*
secrets.yaml
secrets.json
